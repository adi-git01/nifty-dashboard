# Streamlit Secrets Template
# ==========================
# For Streamlit Cloud deployment, copy this content to:
# https://share.streamlit.io → Your App → Settings → Secrets
#
# Replace the placeholder values with your actual credentials

[email]
gmail_address = "your.email@gmail.com"
app_password = "xxxx xxxx xxxx xxxx"

# ---------------------------------------------------------------------------
# GitHub — makes RS alerts durable across devices
# ---------------------------------------------------------------------------
# Without this the dashboard stores RS alerts on the local filesystem only, so
# they disappear when you switch machine or when a Streamlit Cloud container
# restarts. With it, alerts are read from and written to data/rs_alerts.json in
# the repo — the same place positions.json lives — so every device sees the
# same list and the EOD workflow can fire them while the dashboard is closed.
#
# Use a fine-grained personal access token scoped to THIS repo with
# Repository permissions -> Contents: Read and write. Nothing else is needed.
[github]
token  = "github_pat_xxxxxxxxxxxxxxxxxxxx"
repo   = "adi-git01/nifty-dashboard"
branch = "main"

# ---------------------------------------------------------------------------
# LLM — OpenAI-compatible transport (OpenCode, or any server speaking /v1)
# ---------------------------------------------------------------------------
# Call sites request a ROLE, not a model, so swapping models is a config change:
#   research  -> high volume, web-capable, cited output (one call per name)
#   judgment  -> low volume, must adhere to the card JSON schema
#
# Env overrides for local/CI runs: OPENCODE_API_KEY, DEEPSEEK_API_KEY,
# LLM_BASE_URL, LLM_API_KEY, LLM_MODEL_RESEARCH, LLM_MODEL_JUDGMENT.
#
# Quick top-level keys (picked up automatically by Expert Council & llm_client):
# OPENCODE_API_KEY = "sk-xxxxxxxxxxxxxxxx"   # defaults to OpenCode Go (https://opencode.ai/zen/go/v1)
# DEEPSEEK_API_KEY = "sk-xxxxxxxxxxxxxxxx"
#
[llm.providers.opencode_go]
base_url = "https://opencode.ai/zen/go/v1" # OpenCode Go subscription (glm-5.3, kimi-k2.6, etc.)
api_key  = "sk-xxxxxxxxxxxxxxxx"

[llm.providers.opencode]
base_url = "https://opencode.ai/zen/v1" # OpenCode Zen pay-as-you-go (or http://localhost:4096/v1 local)
api_key  = "sk-xxxxxxxxxxxxxxxx"

[llm.providers.deepseek]
base_url = "https://api.deepseek.com/v1"
api_key  = "sk-xxxxxxxxxxxxxxxx"        # Official DeepSeek API key

[llm.roles.research]
provider = "opencode_go"
model    = "glm-5.3"                    # or kimi-k2.6 / deepseek-v4.1-flash

[llm.roles.judgment]
provider = "opencode_go"
model    = "kimi-k2.6"                  # or glm-5.3 / deepseek-chat / deepseek-reasoner

# ---------------------------------------------------------------------------
# Broker sync (Position Manager -> Import). Read-only: holdings only.
# ---------------------------------------------------------------------------
# Zerodha: create an app at developers.kite.trade and set its Redirect URL to this
# dashboard's address (e.g. https://your-app.streamlit.app/).
# [kite]
# api_key = "xxxxxxxxxxxxxxxx"
# api_secret = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#
# Dhan: optional. Without it, paste a 24-hour access token in the Import tab.
# client_id  = your Dhan client ID (the number in your Dhan profile)
# api_key    = the API key Dhan shows when you create the key -- NOT the app name
# api_secret = the API secret shown with it
# [dhan]
# client_id = "1000000000"
# api_key = "xxxxxxxx"
# api_secret = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
