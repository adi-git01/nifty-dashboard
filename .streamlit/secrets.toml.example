# Streamlit Secrets Template
# ==========================
# For Streamlit Cloud deployment, copy this content to:
# https://share.streamlit.io → Your App → Settings → Secrets
#
# Replace the placeholder values with your actual credentials

[email]
gmail_address = "your.email@gmail.com"
app_password = "xxxx xxxx xxxx xxxx"

# ---------------------------------------------------------------------------
# GitHub — makes RS alerts durable across devices
# ---------------------------------------------------------------------------
# Without this the dashboard stores RS alerts on the local filesystem only, so
# they disappear when you switch machine or when a Streamlit Cloud container
# restarts. With it, alerts are read from and written to data/rs_alerts.json in
# the repo — the same place positions.json lives — so every device sees the
# same list and the EOD workflow can fire them while the dashboard is closed.
#
# Use a fine-grained personal access token scoped to THIS repo with
# Repository permissions -> Contents: Read and write. Nothing else is needed.
[github]
token  = "github_pat_xxxxxxxxxxxxxxxxxxxx"
repo   = "adi-git01/nifty-dashboard"
branch = "main"

# ---------------------------------------------------------------------------
# LLM — OpenAI-compatible transport (OpenCode, or any server speaking /v1)
# ---------------------------------------------------------------------------
# Call sites request a ROLE, not a model, so swapping models is a config change:
#   research  -> high volume, web-capable, cited output (one call per name)
#   judgment  -> low volume, must adhere to the card JSON schema
#
# Env overrides for local/CI runs: LLM_BASE_URL, LLM_API_KEY,
# LLM_MODEL_RESEARCH, LLM_MODEL_JUDGMENT.
[llm.providers.opencode]
base_url = "http://localhost:4096/v1"   # confirm against `opencode serve`
api_key  = "not-needed"                 # local servers usually ignore this

[llm.roles.research]
provider = "opencode"
model    = "deepseek-v4-flash"

[llm.roles.judgment]
provider = "opencode"
model    = "gpt-5.6-luna"               # or kimi-k3; deepseek-v4-flash-free while testing
